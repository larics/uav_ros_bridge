<launch>
  <arg name="namespace" default="$(env UAV_NAMESPACE)"/>
  <arg name="config"    default="$(find uav_ros_bridge)/config/drone_interface/mqtt_adapter.yaml"/>
  <arg name="host"      default="localhost"/>
  <arg name="port"      default="1883"/>
  <arg name="profile"   default=""/>

  <node name="drone_interface_mqtt_adapter" pkg="uav_ros_bridge" type="drone_interface_mqtt_adapter.py"
        output="screen" ns="$(arg namespace)">
    <rosparam file="$(arg config)" command="load"/>
    <param name="host"    value="$(arg host)"/>
    <param name="port"    value="$(arg port)"/>
    <param name="profile" value="$(arg profile)"/>
  </node>
</launch>
